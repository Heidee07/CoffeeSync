<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CoffeeSync</title>

    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.css" />

    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Geologica:wght@100..900&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Caveat:wght@600&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="https://cdn.datatables.net/1.13.7/css/jquery.dataTables.min.css" />
    <link rel="stylesheet" href="https://cdn.datatables.net/responsive/2.5.0/css/responsive.dataTables.min.css" />

    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CoffeeSync.styles.css" asp-append-version="true" />
    @RenderSection("Styles", required: false)
</head>
<body class="d-flex flex-column min-vh-100">
    <header>
        <nav class="navbar navbar-expand-lg navbar-toggleable-lg border-bottom shadow-sm mb-3 mt-2">
            <div class="container-fluid">
                <!-- El logo siempre se muestra -->
                <a class="navbar-brand link-color-dark" asp-area="" asp-controller="Home" asp-action="Index">
                    <img src="/images/logo-lg.png" style="width: 9rem; height: 3rem;">
                </a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#menuPrincipal" aria-controls="menuPrincipal" aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>

                <div class="navbar-collapse collapse justify-content-between" id="menuPrincipal">

                    @if (User.Identity.IsAuthenticated)
                    {
                        <ul class="navbar-nav flex-grow-1">
                            <li class="nav-item">
                                <a class="nav-link link-color-dark" asp-area="" asp-controller="Home" asp-action="Index">
                                    <i class="bi bi-house-door-fill"></i> Home
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link link-color-dark" asp-area="" asp-controller="Ordenes" asp-action="Create">
                                    <i class="bi bi-cart-plus-fill"></i> Crear Orden
                                </a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link link-color-dark" asp-area="" asp-controller="Ordenes" asp-action="Index">
                                    <i class="bi bi-clipboard-fill"></i> Ordenes
                                </a>
                            </li>

                            @if (User.IsInRole("Administrador"))
                            {
                                <li class="nav-item">
                                    <a class="nav-link link-color-dark" asp-area="" asp-controller="Productos" asp-action="Index">
                                        <i class="bi bi-cup-fill"></i> Productos
                                    </a>
                                </li>
                                <li class="nav-item">
                                    <a class="nav-link link-color-dark" asp-area="" asp-controller="Categorias" asp-action="Index">
                                        <i class="bi bi-file-earmark-spreadsheet-fill"></i> Categorías
                                    </a>
                                </li>
                            }
                        </ul>

                        <div class="d-flex align-items-center ms-auto">
                            <span class="navbar-text ms-3 fw-bold txt-primary">
                                <i class="bi bi-person-circle"></i> @User.Identity.Name
                            </span>
                            <a class="btn btn-outline-orange btn-sm ms-3" asp-controller="Cuenta" asp-action="Logout">
                                <i class="bi bi-door-open"></i> Salir
                            </a>
                        </div>
                    }

                </div>
            </div>
        </nav>
    </header>
    <div class="container d-flex flex-column flex-grow-1">
        <main role="main" class="pb-3 mb-5 flex-grow-1 d-flex flex-column justify-content-center">
            @RenderBody()
        </main>
    </div>

    <footer class="custom-footer mt-auto">
        <div class="container d-flex justify-content-between align-items-center pb-2">
            <div class="d-flex align-items-center txt-color-bg-light">
                <i class="bi bi-cup-hot"></i>
                <span class="ms-2">&copy; @DateTime.Now.Year CoffeeSync</span>
                <span class="mx-3">|</span>
                <a asp-area="" asp-controller="Home" asp-action="Privacy" class="footer-link">Privacy</a>
            </div>
            <div class="d-flex align-items-center txt-color-bg-light text-end pe-5">
                <span class="footer-frase me-2 footer-frase">Hecho con pasión, <br />para los amantes del café</span>
                <i class="bi bi-suit-heart txt-primary fs-5 footer-icon"></i>
            </div>
            <div class="position-absolute end-0" style="bottom: 60%; padding-right: 1rem; z-index: 10;">
                <img class="footer-coffee" src="/images/coffee-footer.png" />
            </div>
        </div>
    </footer>


    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="https://cdn.datatables.net/1.13.7/js/jquery.dataTables.min.js"></script>
    <script src="https://cdn.datatables.net/responsive/2.5.0/js/dataTables.responsive.min.js"></script>
    
    <script>
        $(document).ready(function () {
            $('.tabla-datatable').DataTable({
                responsive: true,
                language: {
                    url: 'https://cdn.datatables.net/plug-ins/3.0.2/i18n/es-ES.json',
                    search: "",
                    searchPlaceholder: "Buscar...",
                    paginate: {
                        previous: "← Anterior",
                        next: "Siguiente →"
                    }
                }
            });
        });
    </script>
    
    @await RenderSectionAsync("Scripts", required: false)

</body>
</html>

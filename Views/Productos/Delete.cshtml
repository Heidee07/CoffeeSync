@model CoffeeSync.Models.Producto

@{
    ViewData["Title"] = "Delete";
}

@section Styles {
    <link rel="stylesheet" href="~/css/delete.css" />
}

<div class="txt-color-bg-light m-2">
    <h1>Eliminar Producto</h1>
    <div class="alert alert-danger d-flex align-items-center mt-4" role="alert">
        <i class="bi bi-exclamation-circle icon-sm me-3"></i>
        <div class="m-0 align-middle">
            <h6 class="fw-bold">¿Estás seguro de que deseas eliminar este producto?</h6>
            <p class="mb-0">Esta acción no se puede deshacer.</p>
        </div>
    </div>
</div>

<div class="div-style shadow m-2 p-3 txt-color-bg-light">
    <div class="d-flex justify-content-start align-items-center mb-3">
        <div class="div-icon-sm me-2 d-flex justify-content-center">
            <i class="bi bi-cup-straw icon-sm"></i>
        </div>
        <h4 class="mb-0">Producto</h4>
    </div>

    <hr class="hr1-style" />

    <div class="row align-items-center my-2">
        <dt class="col-sm-3 d-flex align-items-center">
            <div class="div-icon-xsm me-2 d-flex justify-content-center">
                <i class="bi bi-cup icon-xsm"></i>
            </div>
            Nombre
        </dt>
        <dd class="col-sm-9 mb-0">
            @Html.DisplayFor(model => model.Nombre)
        </dd>
    </div>

    <hr class="hr2-style" />
    
    <div class="row align-items-center my-2">
        <dt class="col-sm-3 d-flex align-items-center">
            <div class="div-icon-xsm me-2 d-flex justify-content-center">
                <i class="bi bi-currency-dollar icon-xsm"></i>
            </div>
            Precio
        </dt>
        <dd class="col-sm-9 mb-0">
            @Html.DisplayFor(model => model.Precio)
        </dd>
    </div>

    <hr class="hr2-style" />
        
    <div class="row align-items-center my-2">
        <dt class="col-sm-3 d-flex align-items-center">
            <div class="div-icon-xsm me-2 d-flex justify-content-center">
                <i class="bi bi-check2-square icon-xsm"></i>
            </div>
            Disponible
        </dt>
        <dd class="col-sm-9 mb-0">
            @if (Model.Disponible)
            {
                <span class="badge" style="background-color: #6D7B45;">Sí</span>
            }
            else
            {
                <span class="badge" style="background-color: #9D5817;">No</span>
            }
        </dd>
    </div>
        
    <hr class="hr2-style" />

    <div class="row align-items-center my-2">
        <dt class="col-sm-3 d-flex align-items-center">
            <div class="div-icon-xsm me-2 d-flex justify-content-center">
                <i class="bi bi-file-earmark-spreadsheet icon-xsm"></i>
            </div>
            Categoría
        </dt>
        <dd class="col-sm-9 mb-0">
            @Html.DisplayFor(model => model.Categoria.Nombre)
        </dd>
    </div>
    
    <hr class="hr2-style" />

    <div class="row align-items-center my-2">
        <dt class="col-sm-3 d-flex align-items-center">
            <div class="div-icon-xsm me-2 d-flex justify-content-center">
                <i class="bi bi-image icon-xsm"></i>
            </div>
            Imagen
        </dt>
        <dd class="col-sm-9 mb-0">
            @if (!string.IsNullOrEmpty(Model.UrlImagen))
            {
                <div class="me-3">
                    <img src="@Model.UrlImagen" alt="Imagen actual" style="width: 3.75rem; height: 3.75rem; object-fit: cover;" class="rounded shadow-sm border" />
                </div>
            }
        </dd>
    </div>

    <div class="mt-4 me-2 d-flex align-items-end flex-column">
        <div class="mt-auto">
            <form asp-action="Delete">
                <input type="hidden" asp-for="Id" />
                <a asp-action="Index" class="btn btn-outline-yellow">
                    Cancelar
                </a>
                <input type="submit" value="Eliminar Producto" class="btn btn-orange ms-3" />
            </form>
        </div>
    </div>
</div>

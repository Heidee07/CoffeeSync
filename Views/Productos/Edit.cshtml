@model CoffeeSync.Models.Producto

@{
    ViewData["Title"] = "Edit";
}

@section Styles {
    <link rel="stylesheet" href="~/css/edit.css" />
}

<div class="txt-color-bg-light m-2">
    <h1>Editar Producto</h1>
    <h6>Modifica los datos del producto seleccionado.</h6>
</div>

<div class="row txt-color-bg-light m-2">
    <div class="col-md-12 div-style shadow">
        <form asp-action="Edit" enctype="multipart/form-data">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>            
            <input type="hidden" asp-for="Id" />
            <input type="hidden" asp-for="UrlImagen" />
            <div class="form-group mb-3">
                <label asp-for="Nombre" class="control-label">Nombre</label>
                <div class="input-group mb-3 w-75">
                    <span class="input-group-text" id="basic-addon1">
                        <i class="bi bi-cup"></i>
                    </span>
                    <input asp-for="Nombre" class="form-control" />
                </div>
                <span asp-validation-for="Nombre" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="CategoriaId" class="control-label">Categoría</label>
                <div class="input-group mb-3 w-75">
                    <span class="input-group-text" id="basic-addon1">
                        <i class="bi bi-file-earmark-spreadsheet"></i>
                    </span>
                    <select asp-for="CategoriaId" class="form-control" asp-items="ViewBag.CategoriaId"></select>
                </div>
                <span asp-validation-for="CategoriaId" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Precio" class="control-label">Precio</label>
                <div class="input-group mb-3 w-75">
                    <span class="input-group-text" id="basic-addon1">
                        <i class="bi bi-currency-dollar"></i>
                    </span>
                    <input asp-for="Precio" class="form-control" />
                </div>
                <span asp-validation-for="Precio" class="text-danger"></span>
            </div>
            <div class="form-group form-check form-switch mb-3 d-flex align-items-center">
                <input class="form-check-input custom-switch me-2" type="checkbox" role="switch" asp-for="Disponible" id="switchDisponible" style="width: 2.5em; height: 1.2em;" />

                <label class="form-check-label fw-bold txt-primary mt-1" for="switchDisponible">
                    @Html.DisplayNameFor(model => model.Disponible)
                </label>
            </div>
            <div class="form-group mt-3 mb-4">
                <label class="control-label mb-2">Actualizar Imagen (Opcional)</label>
                <div class="d-flex align-items-center w-75">

                    @if (!string.IsNullOrEmpty(Model.UrlImagen))
                    {
                        <div class="me-3">
                            <img src="@Model.UrlImagen" alt="Imagen actual" style="width: 3.75rem; height: 3.75rem; object-fit: cover;" class="rounded shadow-sm border" />
                        </div>
                    }
                    <div class="input-group flex-grow-1">
                        <span class="input-group-text" id="basic-addon2">
                            <i class="bi bi-file-earmark-image"></i>
                        </span>
                        <input type="file" name="imagen" class="form-control" accept="image/*" />
                    </div>
                </div>
                <small class="text-muted d-block mt-2">Si no seleccionas nada, se conservará la imagen actual.</small>
            </div>
            <div class="alert alert-primary d-flex align-items-center mt-4" role="alert">
                <i class="bi bi-info-circle-fill me-3"></i>
                <div>
                    Asegúrate de revisar los datos antes de guardar los cambios.
                </div>
            </div>
            <div class="form-group text-end d-flex justify-content-end">
                <a asp-action="Index" class="btn btn-outline-yellow me-5">Cancelar</a>

                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

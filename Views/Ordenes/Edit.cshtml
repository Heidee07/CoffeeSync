@model CoffeeSync.Models.Orden

@{
    ViewData["Title"] = "Edit";
}

@section Styles {
    <link rel="stylesheet" href="~/css/edit.css" />
}

<div class="txt-color-bg-light m-2">
    <h1>Editar Orden</h1>
    <h6>Modifica los datos de la orden seleccionada.</h6>
</div>

<div class="row txt-color-bg-light m-2">
    <div class="col-md-12 col-style shadow">
        <form asp-action="Edit">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
            <input type="hidden" asp-for="Id" />
            <div class="form-group mb-3">
                <label asp-for="NombreCliente" class="control-label">Nombre del Cliente</label>
                <div class="input-group mb-3 w-75">
                    <span class="input-group-text" id="basic-addon1">
                        <i class="bi bi-person"></i>
                    </span>
                    <input asp-for="NombreCliente" class="form-control" />
                </div>
                <span asp-validation-for="NombreCliente" class="text-danger"></span>
            </div>            
            <div class="form-group mb-3">
                <label asp-for="TotalPagar" class="control-label">Total</label>
                <div class="input-group mb-3 w-75">
                    <span class="input-group-text" id="basic-addon1">
                        <i class="bi bi-currency-dollar"></i>
                    </span>
                    <input asp-for="TotalPagar" class="form-control" />
                </div>
                <span asp-validation-for="TotalPagar" class="text-danger"></span>
            </div>
            <div class="form-group mb-3">
                <label asp-for="Fecha" class="control-label">Fecha</label>
                <div class="input-group mb-3 w-75">
                    <span class="input-group-text" id="basic-addon1">
                        <i class="bi bi-calendar"></i>
                    </span>
                    <input asp-for="Fecha" class="form-control" />
                </div>
                <span asp-validation-for="Fecha" class="text-danger"></span>
            </div>

            <div class="alert alert-primary d-flex align-items-center mt-4" role="alert">
                <i class="bi bi-info-circle-fill me-3"></i>
                <div>
                    Asegúrate de revisar los datos antes de guardar los cambios.
                </div>
            </div>

            <div class="form-group text-end d-flex justify-content-end">
               
                <a asp-action="Index" class="btn btn-outline-yellow me-5">Cancelar</a>

                <input type="submit" value="Guardar Cambios" class="btn btn-primary" />
            </div>
        </form>
    </div>
</div>

<div>
</div>

@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}
